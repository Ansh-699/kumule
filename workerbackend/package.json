{
  "name": "workerbackend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "//check:build": "The bundle esbuild produces for workerd resolves packages under different conditions than tsx does, so tsc passing is not evidence the worker deploys. Run this before trusting any green check.",
    "check:build": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm run check:build && npm run check:units",
    "check:units": "for c in security audit burn escrow mint auth-parity openapi searchnftbyasset searchnftbyowner nfts-price admin-range; do echo \"--- $c ---\"; tsx \"$c-check.ts\" || exit 1; done",
    "test:api": "node api-test.mjs",
    "test:security": "tsx security-check.ts",
    "db:check": "node prisma/apply-bootstrap.mjs",
    "db:repair": "node prisma/apply-bootstrap.mjs --apply",
    "db:bootstrap:build": "node prisma/build-bootstrap.mjs > prisma/bootstrap.sql"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.38.6",
    "@hono/swagger-ui": "^0.5.3",
    "@metaplex-foundation/mpl-core": "^1.7.0",
    "@metaplex-foundation/mpl-toolbox": "^0.10.0",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
    "@metaplex-foundation/umi-uploader-irys": "^1.4.1",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^6.8.2",
    "@prisma/adapter-pg": "^6.8.2",
    "@prisma/client": "^6.8.2",
    "@solana/web3.js": "^1.98.4",
    "@types/ws": "^8.18.1",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "hono": "^4.10.6",
    "pg": "^8.16.3",
    "prisma": "^6.8.2",
    "viem": "^2.55.13",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.4.0"
  }
}

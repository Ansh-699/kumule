// Kumule v2 - multi-chain NFT marketplace (Solana devnet + Base Sepolia).
//
// Rewritten from the v1 schema. 21 models became 12. What went and why:
//   RewardAccount, Interaction, RewardNft, ClaimedReward, RewardDraft
//     - a second, parallel reward system competing with event medals. Medals won.
//   EventRewardConfig  - folded into EventMedal; one row per medal beats one row of
//                        gold_*/silver_*/bronze_* triplets.
//   Escrow, EventEscrow - folded into Listing. A listing IS the escrow state.
//   PaymentLog          - existed only to log Coinbase Commerce webhooks, which is a
//                        product that shut down in March 2026.
//   Dispute             - no surface in the v2 design.
//
// Album and Track are kept: music NFTs with audio streaming are a real v1 feature. They
// no longer carry their own nftAsset/metadataUri columns though - a minted track points at
// an Nft row, so on-chain identity has exactly one home.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Display-level chain, matching the badge on every card in the UI. The specific EVM
// network lives in chainId (84532 = Base Sepolia), so moving to Base mainnet or another
// L2 later is a chainId change, not a schema migration.
enum Chain {
  SOLANA
  ETHEREUM
}

enum Category {
  ART
  PFP
  GAMING
  PHOTOGRAPHY
  MUSIC
  UTILITY
  VIRTUAL_WORLDS
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum MedalTier {
  GOLD
  SILVER
  BRONZE
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// A Stripe payment's lifecycle. Deliberately separate from MintJobStatus: money settling
// and an NFT existing are different facts, and conflating them is how a refunded payment
// keeps a minted asset - or a failed mint hides a successful charge.
enum PaymentStatus {
  REQUIRES_PAYMENT
  PAID
  FAILED
  REFUNDED
}

// BLOCKED is not a failure we retry. It means the derived asset address already holds an
// account that is not our Core asset - someone dusted it, or a seed rotation moved the
// derivation - so minting there can never succeed and a human has to decide.
enum MintJobStatus {
  AWAITING_PAYMENT
  PENDING
  MINTING
  MINTED
  FAILED
  BLOCKED
  REFUNDED
}

model User {
  id           String             @id @default(uuid())
  handle       String?            @unique
  avatarUrl    String?            @map("avatar_url")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  wallets      Wallet[]
  likes        Like[]
  participants EventParticipant[]
  claims       MedalClaim[]
  transactions Transaction[]
  payments     Payment[]

  @@map("users")
}

// One user can hold a Solana wallet and an EVM wallet at once, which is the whole point
// of a multi-chain marketplace. Uniqueness is per (chain, address), not address alone.
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  chain     Chain
  address   String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
  @@index([address])
  @@map("wallets")
}

model Collection {
  id              String   @id @default(uuid())
  chain           Chain
  chainId         Int?     @map("chain_id")
  slug            String   @unique
  name            String
  description     String?
  imageUrl        String?  @map("image_url")
  bannerUrl       String?  @map("banner_url")
  category        Category @default(OTHER)
  verified        Boolean  @default(false)
  creatorAddress  String   @map("creator_address")
  // Solana: collection mint. EVM: ERC-721 contract address.
  contractAddress String?  @map("contract_address")
  itemCount       Int      @default(0) @map("item_count")
  // Denormalised for the card grid; recomputed by the indexer rather than joined per render.
  floorPrice      Decimal? @map("floor_price") @db.Decimal(38, 18)
  volume          Decimal  @default(0) @db.Decimal(38, 18)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  nfts            Nft[]

  @@index([chain])
  @@index([category])
  @@index([verified])
  @@map("collections")
}

model Nft {
  id              String  @id @default(uuid())
  chain           Chain
  chainId         Int?    @map("chain_id")
  // Canonical cross-chain identity: Solana uses the mint address, EVM uses
  // "<contract>:<tokenId>" lowercased. One unique key means lookups never branch on chain.
  assetId         String  @unique @map("asset_id")
  // Kept alongside assetId so EVM queries can filter on contract or token without parsing.
  contractAddress String? @map("contract_address")
  tokenId         String? @map("token_id")
  mintAddress     String? @map("mint_address")

  collectionId String?  @map("collection_id")
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  metadataUri  String?  @map("metadata_uri")
  animationUrl String?  @map("animation_url")
  category     Category @default(OTHER)
  attributes   Json?
  // An NFT with no resolvable image is hidden rather than deleted, so the indexer can
  // recover it if the metadata host comes back. v1 shipped 152 of these.
  imageOk      Boolean  @default(false) @map("image_ok")
  hidden       Boolean  @default(false)

  ownerAddress   String  @map("owner_address")
  creatorAddress String? @map("creator_address")
  likeCount      Int     @default(0) @map("like_count")

  mintedAt  DateTime @default(now()) @map("minted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  collection Collection? @relation(fields: [collectionId], references: [id])
  listings   Listing[]
  sales      Sale[]
  likes      Like[]
  medal      EventMedal?
  album      Album?
  track      Track?
  mintJob    MintJob?

  @@index([chain])
  @@index([ownerAddress])
  @@index([collectionId])
  @@index([category])
  @@index([chain, hidden])
  @@index([imageOk])
  @@map("nfts")
}

// A listing is the escrow record. On Solana the NFT sits in an escrow PDA; on Base the
// seller grants an approval and the asset never leaves their wallet. Both are one row.
model Listing {
  id            String        @id @default(uuid())
  nftId         String        @map("nft_id")
  chain         Chain
  sellerAddress String        @map("seller_address")
  price         Decimal       @db.Decimal(38, 18)
  currency      String // "SOL" | "ETH"
  status        ListingStatus @default(ACTIVE)
  // Solana only: the escrow PDA holding the asset.
  escrowPda     String?       @map("escrow_pda")
  listTxHash    String?       @map("list_tx_hash")
  closeTxHash   String?       @map("close_tx_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  nft           Nft           @relation(fields: [nftId], references: [id], onDelete: Cascade)
  sale          Sale?

  @@index([status])
  @@index([chain, status])
  @@index([sellerAddress])
  @@index([nftId])
  @@map("listings")
}

model Sale {
  id            String   @id @default(uuid())
  nftId         String   @map("nft_id")
  listingId     String?  @unique @map("listing_id")
  chain         Chain
  sellerAddress String   @map("seller_address")
  buyerAddress  String   @map("buyer_address")
  price         Decimal  @db.Decimal(38, 18)
  currency      String
  txHash        String   @unique @map("tx_hash")
  soldAt        DateTime @default(now()) @map("sold_at")
  nft           Nft      @relation(fields: [nftId], references: [id], onDelete: Cascade)
  listing       Listing? @relation(fields: [listingId], references: [id])

  @@index([chain])
  @@index([soldAt])
  @@index([nftId])
  @@map("sales")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  nftId     String   @map("nft_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nft       Nft      @relation(fields: [nftId], references: [id], onDelete: Cascade)

  @@unique([userId, nftId])
  @@index([nftId])
  @@map("likes")
}

// Admin-created. Users join, accumulate points, and claim a medal NFT once they cross a
// tier threshold. Points are granted through an admin-authenticated endpoint - deliberately
// mocked rather than derived from verified on-chain activity.
model Event {
  id           String             @id @default(uuid())
  slug         String             @unique
  name         String
  description  String?
  imageUrl     String?            @map("image_url")
  status       EventStatus        @default(DRAFT)
  startsAt     DateTime?          @map("starts_at")
  endsAt       DateTime?          @map("ends_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  medals       EventMedal[]
  participants EventParticipant[]
  claims       MedalClaim[]

  @@index([status])
  @@map("events")
}

// One row per medal tier per event. Minted to the vault wallet up front, then transferred
// to a claimant. nftId links to the vault-held asset once minted.
model EventMedal {
  id             String       @id @default(uuid())
  eventId        String       @map("event_id")
  tier           MedalTier
  chain          Chain        @default(SOLANA)
  name           String
  description    String?
  imageUrl       String?      @map("image_url")
  metadataUri    String?      @map("metadata_uri")
  requiredPoints Int          @map("required_points")
  supply         Int          @default(1)
  claimedCount   Int          @default(0) @map("claimed_count")
  // The vault-held asset backing this medal, once minted.
  nftId          String?      @unique @map("nft_id")
  mintTxHash     String?      @map("mint_tx_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nft            Nft?         @relation(fields: [nftId], references: [id])
  claims         MedalClaim[]

  @@unique([eventId, tier])
  @@index([eventId])
  @@map("event_medals")
}

model EventParticipant {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  userId         String   @map("user_id")
  walletAddress  String   @map("wallet_address")
  chain          Chain
  points         Int      @default(0)
  tasksCompleted Int      @default(0) @map("tasks_completed")
  joinedAt       DateTime @default(now()) @map("joined_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([walletAddress])
  @@map("event_participants")
}

model MedalClaim {
  id            String     @id @default(uuid())
  medalId       String     @map("medal_id")
  eventId       String     @map("event_id")
  userId        String     @map("user_id")
  walletAddress String     @map("wallet_address")
  pointsAtClaim Int        @map("points_at_claim")
  txHash        String?    @map("tx_hash")
  claimedAt     DateTime   @default(now()) @map("claimed_at")
  medal         EventMedal @relation(fields: [medalId], references: [id], onDelete: Cascade)
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One claim per user per medal, enforced by the database rather than by handler logic.
  @@unique([medalId, userId])
  @@index([eventId])
  @@index([walletAddress])
  @@map("medal_claims")
}

// ---------------------------------------------------------------------------
// Music NFTs. An album groups tracks; either the album or an individual track can be
// minted on either chain. Audio lives in R2 and streams through the worker's /cdn/audio
// route, which supports range requests so seeking works.

model Album {
  id             String    @id @default(uuid())
  chain          Chain
  slug           String    @unique
  name           String
  artist         String
  description    String?
  coverUrl       String    @map("cover_url")
  genre          String?
  releaseDate    DateTime? @map("release_date")
  // Price for buying the album as a whole; individual tracks price themselves.
  price          Decimal?  @db.Decimal(38, 18)
  currency       String?
  creatorAddress String    @map("creator_address")
  isPublished    Boolean   @default(false) @map("is_published")
  trackCount     Int       @default(0) @map("track_count")
  // Set once the album itself is minted as a single NFT.
  nftId          String?   @unique @map("nft_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  nft            Nft?      @relation(fields: [nftId], references: [id])
  tracks         Track[]

  @@index([chain])
  @@index([artist])
  @@index([creatorAddress])
  @@index([isPublished])
  @@map("albums")
}

model Track {
  id             String   @id @default(uuid())
  albumId        String   @map("album_id")
  title          String
  description    String?
  audioUrl       String   @map("audio_url")
  artworkUrl     String?  @map("artwork_url")
  durationSec    Int?     @map("duration_sec")
  trackNumber    Int      @map("track_number")
  price          Decimal? @db.Decimal(38, 18)
  currency       String?
  // SHA-256 of the uploaded audio, so a swapped file is detectable after minting.
  integrityHash  String?  @map("integrity_hash")
  isPreviewable  Boolean  @default(true) @map("is_previewable")
  previewSeconds Int      @default(30) @map("preview_seconds")
  // Set once this track is minted as its own NFT.
  nftId          String?  @unique @map("nft_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  album          Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  nft            Nft?     @relation(fields: [nftId], references: [id])

  @@unique([albumId, trackNumber])
  @@index([albumId])
  @@map("tracks")
}

// Mint fees and marketplace purchases. Kept for the admin dashboard and user history.
model Transaction {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  chain         Chain
  kind          String // "MINT" | "PURCHASE" | "MEDAL_CLAIM"
  status        String // "PENDING" | "CONFIRMED" | "FAILED"
  walletAddress String?  @map("wallet_address")
  amount        Decimal? @db.Decimal(38, 18)
  currency      String?
  txHash        String?  @unique @map("tx_hash")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User?    @relation(fields: [userId], references: [id])

  @@index([walletAddress])
  @@index([chain])
  @@index([status])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Stripe rail. Money is EUR and lives here; chain work lives in MintJob. Nothing in this
// section writes a Decimal: fiat is exact integer minor units (cents), which is also the
// only shape Stripe accepts.

// What we quoted, and everything needed to reproduce it later. Kept even after the
// payment settles: "estimated fee charged vs actual fee paid" is unanswerable without the
// exchange rate that was in force when the quote was made.
//
// There is deliberately no consumed/used flag. A replayed quote produces a second
// PaymentIntent, so the buyer pays twice and gets two NFTs - correct behaviour, not a
// loss. The thing that must be single-use is the payment, and MintJob.paymentId is unique.
model FeeQuote {
  id                 String   @id @default(uuid())
  operation          String
  chain              Chain    @default(SOLANA)
  quantity           Int      @default(1)
  currency           String   @default("eur")
  // Signature fee + priority fee + rent exemption, per the whole quote (already
  // multiplied by quantity).
  networkFeeLamports BigInt   @map("network_fee_lamports")
  /// Size of the asset account this quote paid rent for. createIntent refuses anything that
  /// would not fit, so a quote can never under-cover the asset it is spent on.
  assetBytes         Int      @default(403) @map("asset_bytes")
  // EUR per SOL, scaled by 1e8 and held as an integer. A float rate would put rounding
  // error into every fee this row explains.
  rateScaled         BigInt   @map("rate_scaled")
  estimatedFeeMinor  Int      @map("estimated_fee_minor")
  source             String
  confidence         String
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  payment            Payment?

  @@index([expiresAt])
  @@map("fee_quotes")
}

model Payment {
  id                    String        @id @default(uuid())
  // Nullable because the row is written BEFORE Stripe is called: a Stripe call that fails
  // after the row exists is a retryable no-op, whereas a row write that fails after the
  // charge exists is an orphaned payment nothing can find.
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  currency              String        @default("eur")
  baseAmountMinor       Int           @map("base_amount_minor")
  taxAmountMinor        Int           @map("tax_amount_minor")
  mintFeeMinor          Int           @map("mint_fee_minor")
  totalAmountMinor      Int           @map("total_amount_minor")
  quoteId               String?       @unique @map("quote_id")
  userId                String?       @map("user_id")
  stripeRefundId        String?       @map("stripe_refund_id")
  failureReason         String?       @map("failure_reason")
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  quote                 FeeQuote?     @relation(fields: [quoteId], references: [id])
  user                  User?         @relation(fields: [userId], references: [id])
  mintJob               MintJob?

  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

// One payment, one mint. The unique constraint on paymentId is the database half of "the
// same Stripe payment cannot mint twice" - not handler logic, which a retry can re-enter.
// Supporting quantity > 1 later means replacing it with @@unique([paymentId, index]).
model MintJob {
  id        String        @id @default(uuid())
  paymentId String        @unique @map("payment_id")
  status    MintJobStatus @default(AWAITING_PAYMENT)
  attempts  Int           @default(0)
  chain     Chain         @default(SOLANA)

  // Everything createV1 needs, captured at checkout while the buyer was still present.
  ownerAddress String @map("owner_address")
  name         String
  metadataUri  String @map("metadata_uri")

  // Derived from (seed, paymentId) and written at claim time, before the send, so a retry
  // targets the same account instead of minting a second asset.
  mintAddress String? @unique @map("mint_address")
  // Which derivation produced mintAddress. Rotating the seed without this makes every
  // in-flight job unmintable with no way to tell why.
  seedVersion Int     @default(1) @map("seed_version")
  txSignature String? @unique @map("tx_signature")

  estimatedFeeMinor Int     @map("estimated_fee_minor")
  // What the platform wallet actually spent: transaction fee plus the rent it will never
  // get back. Read from the fee payer's balance delta, not from meta.fee alone.
  actualFeeLamports BigInt? @map("actual_fee_lamports")
  actualFeeMinor    Int?    @map("actual_fee_minor")

  ownershipVerified Boolean   @default(false) @map("ownership_verified")
  ownershipSource   String?   @map("ownership_source")
  nftId             String?   @unique @map("nft_id")
  lastError         String?   @map("last_error")
  // Lease timestamp. Without it an isolate evicted mid-confirm leaves the row in MINTING
  // forever and no sweep ever looks at it again.
  lockedAt          DateTime? @map("locked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  nft     Nft?    @relation(fields: [nftId], references: [id])

  @@index([status])
  @@index([status, lockedAt])
  @@map("mint_jobs")
}

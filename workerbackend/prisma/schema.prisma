// Kumule v2 - multi-chain NFT marketplace (Solana devnet + Base Sepolia).
//
// Rewritten from the v1 schema. 21 models became 12. What went and why:
//   RewardAccount, Interaction, RewardNft, ClaimedReward, RewardDraft
//     - a second, parallel reward system competing with event medals. Medals won.
//   EventRewardConfig  - folded into EventMedal; one row per medal beats one row of
//                        gold_*/silver_*/bronze_* triplets.
//   Escrow, EventEscrow - folded into Listing. A listing IS the escrow state.
//   PaymentLog          - existed only to log Coinbase Commerce webhooks, which is a
//                        product that shut down in March 2026.
//   Dispute             - no surface in the v2 design.
//
// Album and Track are kept: music NFTs with audio streaming are a real v1 feature. They
// no longer carry their own nftAsset/metadataUri columns though - a minted track points at
// an Nft row, so on-chain identity has exactly one home.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Display-level chain, matching the badge on every card in the UI. The specific EVM
// network lives in chainId (84532 = Base Sepolia), so moving to Base mainnet or another
// L2 later is a chainId change, not a schema migration.
enum Chain {
  SOLANA
  ETHEREUM
}

enum Category {
  ART
  PFP
  GAMING
  PHOTOGRAPHY
  MUSIC
  UTILITY
  VIRTUAL_WORLDS
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum MedalTier {
  GOLD
  SILVER
  BRONZE
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           String             @id @default(uuid())
  handle       String?            @unique
  avatarUrl    String?            @map("avatar_url")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  wallets      Wallet[]
  likes        Like[]
  participants EventParticipant[]
  claims       MedalClaim[]
  transactions Transaction[]

  @@map("users")
}

// One user can hold a Solana wallet and an EVM wallet at once, which is the whole point
// of a multi-chain marketplace. Uniqueness is per (chain, address), not address alone.
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  chain     Chain
  address   String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
  @@index([address])
  @@map("wallets")
}

model Collection {
  id              String   @id @default(uuid())
  chain           Chain
  chainId         Int?     @map("chain_id")
  slug            String   @unique
  name            String
  description     String?
  imageUrl        String?  @map("image_url")
  bannerUrl       String?  @map("banner_url")
  category        Category @default(OTHER)
  verified        Boolean  @default(false)
  creatorAddress  String   @map("creator_address")
  // Solana: collection mint. EVM: ERC-721 contract address.
  contractAddress String?  @map("contract_address")
  itemCount       Int      @default(0) @map("item_count")
  // Denormalised for the card grid; recomputed by the indexer rather than joined per render.
  floorPrice      Decimal? @map("floor_price") @db.Decimal(38, 18)
  volume          Decimal  @default(0) @db.Decimal(38, 18)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  nfts            Nft[]

  @@index([chain])
  @@index([category])
  @@index([verified])
  @@map("collections")
}

model Nft {
  id           String   @id @default(uuid())
  chain        Chain
  chainId      Int?     @map("chain_id")
  // Canonical cross-chain identity: Solana uses the mint address, EVM uses
  // "<contract>:<tokenId>" lowercased. One unique key means lookups never branch on chain.
  assetId      String   @unique @map("asset_id")
  // Kept alongside assetId so EVM queries can filter on contract or token without parsing.
  contractAddress String? @map("contract_address")
  tokenId         String? @map("token_id")
  mintAddress     String? @map("mint_address")

  collectionId String?  @map("collection_id")
  name         String
  description  String?
  imageUrl     String?  @map("image_url")
  metadataUri  String?  @map("metadata_uri")
  animationUrl String?  @map("animation_url")
  category     Category @default(OTHER)
  attributes   Json?
  // An NFT with no resolvable image is hidden rather than deleted, so the indexer can
  // recover it if the metadata host comes back. v1 shipped 152 of these.
  imageOk      Boolean  @default(false) @map("image_ok")
  hidden       Boolean  @default(false)

  ownerAddress   String  @map("owner_address")
  creatorAddress String? @map("creator_address")
  likeCount      Int     @default(0) @map("like_count")

  mintedAt  DateTime @default(now()) @map("minted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  collection Collection? @relation(fields: [collectionId], references: [id])
  listings   Listing[]
  sales      Sale[]
  likes      Like[]
  medal      EventMedal?
  album      Album?
  track      Track?

  @@index([chain])
  @@index([ownerAddress])
  @@index([collectionId])
  @@index([category])
  @@index([chain, hidden])
  @@index([imageOk])
  @@map("nfts")
}

// A listing is the escrow record. On Solana the NFT sits in an escrow PDA; on Base the
// seller grants an approval and the asset never leaves their wallet. Both are one row.
model Listing {
  id            String        @id @default(uuid())
  nftId         String        @map("nft_id")
  chain         Chain
  sellerAddress String        @map("seller_address")
  price         Decimal       @db.Decimal(38, 18)
  currency      String // "SOL" | "ETH"
  status        ListingStatus @default(ACTIVE)
  // Solana only: the escrow PDA holding the asset.
  escrowPda     String?       @map("escrow_pda")
  listTxHash    String?       @map("list_tx_hash")
  closeTxHash   String?       @map("close_tx_hash")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  nft           Nft           @relation(fields: [nftId], references: [id], onDelete: Cascade)
  sale          Sale?

  @@index([status])
  @@index([chain, status])
  @@index([sellerAddress])
  @@index([nftId])
  @@map("listings")
}

model Sale {
  id            String   @id @default(uuid())
  nftId         String   @map("nft_id")
  listingId     String?  @unique @map("listing_id")
  chain         Chain
  sellerAddress String   @map("seller_address")
  buyerAddress  String   @map("buyer_address")
  price         Decimal  @db.Decimal(38, 18)
  currency      String
  txHash        String   @unique @map("tx_hash")
  soldAt        DateTime @default(now()) @map("sold_at")
  nft           Nft      @relation(fields: [nftId], references: [id], onDelete: Cascade)
  listing       Listing? @relation(fields: [listingId], references: [id])

  @@index([chain])
  @@index([soldAt])
  @@index([nftId])
  @@map("sales")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  nftId     String   @map("nft_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nft       Nft      @relation(fields: [nftId], references: [id], onDelete: Cascade)

  @@unique([userId, nftId])
  @@index([nftId])
  @@map("likes")
}

// Admin-created. Users join, accumulate points, and claim a medal NFT once they cross a
// tier threshold. Points are granted through an admin-authenticated endpoint - deliberately
// mocked rather than derived from verified on-chain activity.
model Event {
  id          String             @id @default(uuid())
  slug        String             @unique
  name        String
  description String?
  imageUrl    String?            @map("image_url")
  status      EventStatus        @default(DRAFT)
  startsAt    DateTime?          @map("starts_at")
  endsAt      DateTime?          @map("ends_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  medals      EventMedal[]
  participants EventParticipant[]
  claims      MedalClaim[]

  @@index([status])
  @@map("events")
}

// One row per medal tier per event. Minted to the vault wallet up front, then transferred
// to a claimant. nftId links to the vault-held asset once minted.
model EventMedal {
  id             String       @id @default(uuid())
  eventId        String       @map("event_id")
  tier           MedalTier
  chain          Chain        @default(SOLANA)
  name           String
  description    String?
  imageUrl       String?      @map("image_url")
  metadataUri    String?      @map("metadata_uri")
  requiredPoints Int          @map("required_points")
  supply         Int          @default(1)
  claimedCount   Int          @default(0) @map("claimed_count")
  // The vault-held asset backing this medal, once minted.
  nftId          String?      @unique @map("nft_id")
  mintTxHash     String?      @map("mint_tx_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nft            Nft?         @relation(fields: [nftId], references: [id])
  claims         MedalClaim[]

  @@unique([eventId, tier])
  @@index([eventId])
  @@map("event_medals")
}

model EventParticipant {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  userId         String   @map("user_id")
  walletAddress  String   @map("wallet_address")
  chain          Chain
  points         Int      @default(0)
  tasksCompleted Int      @default(0) @map("tasks_completed")
  joinedAt       DateTime @default(now()) @map("joined_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([walletAddress])
  @@map("event_participants")
}

model MedalClaim {
  id            String    @id @default(uuid())
  medalId       String    @map("medal_id")
  eventId       String    @map("event_id")
  userId        String    @map("user_id")
  walletAddress String    @map("wallet_address")
  pointsAtClaim Int       @map("points_at_claim")
  txHash        String?   @map("tx_hash")
  claimedAt     DateTime  @default(now()) @map("claimed_at")
  medal         EventMedal @relation(fields: [medalId], references: [id], onDelete: Cascade)
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One claim per user per medal, enforced by the database rather than by handler logic.
  @@unique([medalId, userId])
  @@index([eventId])
  @@index([walletAddress])
  @@map("medal_claims")
}

// ---------------------------------------------------------------------------
// Music NFTs. An album groups tracks; either the album or an individual track can be
// minted on either chain. Audio lives in R2 and streams through the worker's /cdn/audio
// route, which supports range requests so seeking works.

model Album {
  id             String    @id @default(uuid())
  chain          Chain
  slug           String    @unique
  name           String
  artist         String
  description    String?
  coverUrl       String    @map("cover_url")
  genre          String?
  releaseDate    DateTime? @map("release_date")
  // Price for buying the album as a whole; individual tracks price themselves.
  price          Decimal?  @db.Decimal(38, 18)
  currency       String?
  creatorAddress String    @map("creator_address")
  isPublished    Boolean   @default(false) @map("is_published")
  trackCount     Int       @default(0) @map("track_count")
  // Set once the album itself is minted as a single NFT.
  nftId          String?   @unique @map("nft_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  nft            Nft?      @relation(fields: [nftId], references: [id])
  tracks         Track[]

  @@index([chain])
  @@index([artist])
  @@index([creatorAddress])
  @@index([isPublished])
  @@map("albums")
}

model Track {
  id          String   @id @default(uuid())
  albumId     String   @map("album_id")
  title       String
  description String?
  audioUrl    String   @map("audio_url")
  artworkUrl  String?  @map("artwork_url")
  durationSec Int?     @map("duration_sec")
  trackNumber Int      @map("track_number")
  price       Decimal? @db.Decimal(38, 18)
  currency    String?
  // SHA-256 of the uploaded audio, so a swapped file is detectable after minting.
  integrityHash String? @map("integrity_hash")
  isPreviewable   Boolean @default(true) @map("is_previewable")
  previewSeconds  Int     @default(30) @map("preview_seconds")
  // Set once this track is minted as its own NFT.
  nftId       String?  @unique @map("nft_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  nft         Nft?     @relation(fields: [nftId], references: [id])

  @@unique([albumId, trackNumber])
  @@index([albumId])
  @@map("tracks")
}

// Mint fees and marketplace purchases. Kept for the admin dashboard and user history.
model Transaction {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  chain         Chain
  kind          String // "MINT" | "PURCHASE" | "MEDAL_CLAIM"
  status        String // "PENDING" | "CONFIRMED" | "FAILED"
  walletAddress String?  @map("wallet_address")
  amount        Decimal? @db.Decimal(38, 18)
  currency      String?
  txHash        String?  @unique @map("tx_hash")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User?    @relation(fields: [userId], references: [id])

  @@index([walletAddress])
  @@index([chain])
  @@index([status])
  @@map("transactions")
}

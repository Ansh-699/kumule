# Copy to .dev.vars (git-ignored). In production these are Cloudflare secrets.
#
# Every variable here is one the worker actually reads. If you add one, add it to
# CloudflareBindings via `npm run cf-typegen` too.

# --- required -----------------------------------------------------------------

# Postgres. Neon's pooler endpoint in production; anything Postgres-shaped locally.
# db.ts prefers this over the Hyperdrive binding, deliberately: an inherited binding
# should never silently override an explicitly set secret.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Admin routes 503 until this is set. There is no default - a shared fallback key is
# the same as no key.
ADMIN_API_KEY="generate-a-long-random-value"

# --- optional, with working defaults ------------------------------------------

# Defaults to https://api.devnet.solana.com. A paid endpoint is worth it: the public
# devnet node rate-limits, which is why several call sites carry RPC fallbacks.
# SOLANA_RPC_URL="https://devnet.helius-rpc.com/?api-key=YOUR_KEY"

# Defaults to https://base-sepolia-rpc.publicnode.com.
# BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Base Sepolia contracts. Defaults are the deployed pair in contracts-evm/.
# EVM_NFT_ADDRESS="0x416e7Fd93fc2210540AAC1c1cC17a851148DfEBD"
# EVM_MARKET_ADDRESS="0x032774De36621265dc21056026372D7bA6f477eC"

# Charge a mint fee. Unset means minting is free and the caller pays only their own
# network fee. Setting the fee without the treasury is refused rather than ignored.
# MINT_FEE_LAMPORTS="10000000"
# MINT_FEE_TREASURY="<base58 solana address>"

# Base58 secret key of the wallet holding unclaimed event medals. Medal minting and
# claiming return 503 without it - the vault must sign the transfer, so the user's own
# wallet cannot.
# MEDAL_VAULT_PRIVATE_KEY="<base58 64-byte secret key>"

# Absolute origin used to build R2 asset URLs. Derived from the request when unset,
# which is right for local dev and wrong behind a proxy that rewrites the host.
# PUBLIC_URL="https://kumele-backend.example.workers.dev"

# --- stripe rail --------------------------------------------------------------

# Card payments. /api/v1/payments/intent 503s without a key, and the webhook 503s
# without the signing secret - neither falls back to accepting anything.
#
# Use a RESTRICTED key (rk_...), not a secret key. Stripe's own guidance is to stop
# using sk_ keys for new integrations, and this one needs exactly two permissions:
#
#     PaymentIntents  write     POST /v1/payment_intents
#     Refunds         write     POST /v1/refunds
#
# Nothing else. No customers, no balance, no products, no reads. A key scoped that
# narrowly cannot drain an account even if the worker is fully compromised. The code
# sends whatever is here as a Bearer token, so rk_ and sk_ both work unchanged.
#
# Optional hardening: attach an Access Policy in the Stripe dashboard restricting the
# key to Cloudflare's ASN, so it is useless from anywhere but the worker.
# STRIPE_SECRET_KEY="rk_test_..."

# From the Webhooks section of the dashboard, NOT the API keys page - a signing secret
# is per-endpoint and is not an API key. Rotating one does not rotate the other.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional API version pin. Unset means the account default, which is stable per account;
# a version string that does not exist makes every Stripe call fail, so this is not a
# value to guess at.
# STRIPE_API_VERSION="2025-01-27.acacia"

# HMAC root for deterministic mint addresses. Required for minting.
#
# This is a DERIVATION ROOT, not a rotatable secret. Every open mint job derives its asset
# address from it, so rotating it while jobs are in flight makes those jobs underivable -
# they stop with a BLOCKED status rather than minting a second asset. Drain to zero open
# jobs before changing it.
# MINT_ASSET_SEED="generate-a-long-random-value"

# Base58 secret key of the wallet that pays for and signs mints. Falls back to
# MEDAL_VAULT_PRIVATE_KEY, but they are separate settings on purpose: this one only ever
# spends SOL on gas and rent, while the medal vault custodies unclaimed medals.
#
# Needs roughly 0.002 SOL of balance per mint, almost all of it the rent-exempt minimum for
# the new asset account, which the platform never gets back. Checkout refuses with a 503
# when the balance cannot cover the next mint, so a dry vault stops selling rather than
# charging for something it cannot deliver.
# MINT_VAULT_PRIVATE_KEY="<base58 64-byte secret key>"

# Pricing, all in EUR minor units (cents).
# MINT_SERVICE_PRICE_MINOR="200"   # Kumele's charge for a mint; default 200 = EUR 2.00
# TAX_RATE_BPS="0"                 # VAT in basis points; 2000 = 20%
# MINT_FEE_FLOOR_MINOR="15"        # floor under the blockchain fee line
# STRIPE_MIN_CHARGE_MINOR="50"     # Stripe rejects EUR totals under 50; guarded before the call
# FEE_QUOTE_TTL_SECONDS="900"      # how long a quote may be paid against

# Reopens the Solana escrow routes and the wallet-signed mint, which are off by default for
# the card-payment MVP. The code stays in the repo either way.
# ENABLE_DIRECT_CRYPTO="true"


# Get your API key from: https://www.helius.dev/
SOLANA_RPC_URL="https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE"

# Get your Coinbase CDP API keys from: https://portal.cdp.coinbase.com/projects/api-keys
COINBASE_API_KEY_NAME="your-api-key-name"
COINBASE_API_KEY_PRIVATE_KEY="your-api-key-private-key"

# Get your Coinbase Commerce API key from: https://commerce.coinbase.com/dashboard/settings
COINBASE_COMMERCE_API_KEY="your-coinbase-commerce-api-key"

# Coinbase Commerce webhook shared secret - webhooks are rejected without it
COINBASE_WEBHOOK_SECRET="your-coinbase-webhook-shared-secret"

# Stub payments that auto-confirm without a real charge. Local/testing only.
# NEVER set this in production: it makes /api/payment/create hand out fake "paid"
# charges, and mint.ts mints whenever a charge reads COMPLETED. Leave it unset and
# payment endpoints fail closed with 503 until COINBASE_COMMERCE_API_KEY is configured.
# PAYMENTS_DEMO_MODE="true"

# Admin API key for /api/admin/* - no default, admin routes 503 until this is set
ADMIN_API_KEY="generate-a-long-random-value"

# Base58 admin wallet private key, used to sign reward NFT transfers
ADMIN_WALLET_PRIVATE_KEY="your-base58-admin-wallet-private-key"

# Local Hyperdrive connection string (also settable as
# WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

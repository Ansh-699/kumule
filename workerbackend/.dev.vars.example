# Copy to .dev.vars (git-ignored). In production these are Cloudflare secrets.
#
# Every variable here is one the worker actually reads. If you add one, add it to
# CloudflareBindings via `npm run cf-typegen` too.

# --- required -----------------------------------------------------------------

# Postgres. Neon's pooler endpoint in production; anything Postgres-shaped locally.
# db.ts prefers this over the Hyperdrive binding, deliberately: an inherited binding
# should never silently override an explicitly set secret.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Admin routes 503 until this is set. There is no default - a shared fallback key is
# the same as no key.
ADMIN_API_KEY="generate-a-long-random-value"

# --- optional, with working defaults ------------------------------------------

# Defaults to https://api.devnet.solana.com. A paid endpoint is worth it: the public
# devnet node rate-limits, which is why several call sites carry RPC fallbacks.
# SOLANA_RPC_URL="https://devnet.helius-rpc.com/?api-key=YOUR_KEY"

# Defaults to https://base-sepolia-rpc.publicnode.com.
# BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Base Sepolia contracts. Defaults are the deployed pair in contracts-evm/.
# EVM_NFT_ADDRESS="0x416e7Fd93fc2210540AAC1c1cC17a851148DfEBD"
# EVM_MARKET_ADDRESS="0x032774De36621265dc21056026372D7bA6f477eC"

# Charge a mint fee. Unset means minting is free and the caller pays only their own
# network fee. Setting the fee without the treasury is refused rather than ignored.
# MINT_FEE_LAMPORTS="10000000"
# MINT_FEE_TREASURY="<base58 solana address>"

# Base58 secret key of the wallet holding unclaimed event medals. Medal minting and
# claiming return 503 without it - the vault must sign the transfer, so the user's own
# wallet cannot.
# MEDAL_VAULT_PRIVATE_KEY="<base58 64-byte secret key>"

# Absolute origin used to build R2 asset URLs. Derived from the request when unset,
# which is right for local dev and wrong behind a proxy that rewrites the host.
# PUBLIC_URL="https://kumele-backend.example.workers.dev"

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kumele-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Environment variables are loaded from:
  // - .dev.vars file for local development (git-ignored)
  // - Cloudflare dashboard secrets for production
  // No vars defined here to avoid committing secrets
  // No vars here: every secret comes from .dev.vars locally and Cloudflare secrets in
  // production. This file is committed, so nothing sensitive may live in it.
  //
  // Optional: BASE_SEPOLIA_RPC_URL, EVM_NFT_ADDRESS, EVM_MARKET_ADDRESS,
  // MINT_FEE_LAMPORTS, MINT_FEE_TREASURY, MEDAL_VAULT_PRIVATE_KEY, ADMIN_API_KEY.
  // Local dev connection string comes from the environment, never this file - it is committed.
  // Set it in .dev.vars (git-ignored) or export:
  //   WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://..."
  // Hyperdrive binding removed. It was configured against the v1 database, and
  // getConnectionString() prefers Hyperdrive over DATABASE_URL - so leaving it bound would
  // silently keep the worker on the old data no matter what DATABASE_URL is set to.
  //
  // Nothing is lost: the Neon connection string already targets the -pooler endpoint, so
  // Neon pools the connections itself. Re-add this only with a config pointed at the
  // current database.
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // One binding, one bucket. NFT_BUCKET was a second name for this same bucket that no
  // code ever read - two handles to one store is how a write goes to the wrong one.
  // Not a secret, so it belongs here rather than in Cloudflare's secret store: a feature
  // flag you can read in the repo is one you can reason about.
  //
  // TRUE for now, which keeps the deployed behaviour exactly as it was. The MVP choice is
  // "false" - Solana escrow and the wallet-signed mint off, card payment the only way to
  // mint - but flipping it before Stripe is configured would take a working marketplace and
  // leave nothing in its place. Set it to false once the migration has run, the Stripe
  // secrets are set and the mint vault is funded.
  "vars": {
    "ENABLE_DIRECT_CRYPTO": "true"
  },

  // Sweeps mint jobs the webhook could not finish, and refunds the ones that never can.
  // Five minutes rather than every minute: withPrisma opens a fresh Neon WebSocket per call,
  // so a per-minute tick would keep the database awake 1,440 times a day to usually find
  // nothing. The webhook's waitUntil covers the happy-path latency; this is the guarantee.
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "NFT_IMAGES",
      "bucket_name": "nftimages"
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
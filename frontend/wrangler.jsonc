{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kumele",
	"compatibility_date": "2025-11-19",

	// Pure static asset deploy - no `main`, no worker script.
	//
	// The scaffolded worker/index.ts intercepted /api/* and answered {"name":"Cloudflare"}.
	// The app calls the backend at an absolute URL so it never fired, but it would have
	// silently shadowed any relative API path added later. A static SPA needs no worker.
	"assets": {
		"directory": "./dist",
		// Unmatched paths serve index.html so client-side routes like /nft/:assetId work on
		// a hard refresh rather than 404ing.
		"not_found_handling": "single-page-application"
	},

	"observability": {
		"enabled": true
	}
}
